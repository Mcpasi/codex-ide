# Keep rules anchored to the repository root so model-home/ stays included.
# UI assets, package-lock.json and bundled .codexskill packages are source files.

# Dependencies, build output and test reports
/node_modules/
/dist/
/build/
/coverage/
/.nyc_output/
/*.tsbuildinfo

# Local caches and temporary files
/.cache/
/.npm/
/tmp/
/temp/

# Generated npm release archives (keep skill_packages/*.codexskill)
/*.tgz

# Local logs
/*.log
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-debug.log*

# Local environment and credentials; keep example configuration
/.env
/.env.*
!/.env.example
!/.env.sample
!/.env.template
/.aws/
/.codex/auth.json

# Local OS files and editor backups
/.DS_Store
/Thumbs.db
/Desktop.ini
/*.swp
/*.swo
/*~
